# Generate a private .env.docker with: python -m scripts.docker.create_env
# These placeholders are documentation, not usable credentials.
POSTGRES_PASSWORD=replace_with_random_admin_password
DB_PASSWORD=replace_with_random_runtime_password
MIGRATION_DB_PASSWORD=replace_with_random_migration_password
JWT_SECRET=replace_with_random_signing_secret_at_least_32_characters
RABBITMQ_PASSWORD=replace_with_random_broker_password
RABBITMQ_PUBLISHER_PASSWORD=replace_with_separate_random_publisher_password
RABBITMQ_WORKER_PASSWORD=replace_with_separate_random_worker_password
RABBITMQ_REPLAY_PASSWORD=replace_with_separate_random_replay_password
NOTIFICATION_ADMIN_PASSWORD=replace_with_random_notification_admin_password
NOTIFICATION_DB_PASSWORD=replace_with_random_worker_password
NOTIFICATION_API_DB_PASSWORD=replace_with_random_notification_api_password
NOTIFICATION_SERVICE_SECRET=replace_with_separate_random_internal_signing_secret
METRICS_TOKEN=replace_with_separate_random_metrics_token_at_least_32_characters
