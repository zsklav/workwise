DB_HOST=localhost
DB_PORT=5432
DB_NAME=workwise
DB_USER=workwise_app
DB_PASSWORD="replace_with_runtime_password"

MIGRATION_DB_USER=workwise_migrator
MIGRATION_DB_PASSWORD="replace_with_migration_password"

JWT_SECRET="replace_with_a_random_secret_at_least_32_characters"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_RATE_WINDOW_SECONDS=60
AUTH_LOGIN_IP_LIMIT=30
AUTH_LOGIN_ACCOUNT_LIMIT=10
AUTH_SIGNUP_IP_LIMIT=20
AUTH_REFRESH_IP_LIMIT=60
API_IP_LIMIT=300
# CIDRs of reverse proxies whose X-Forwarded-For is trusted (empty = none)
TRUSTED_PROXIES=

# Password reset email: disabled | console (logs links, development only) | smtp
EMAIL_BACKEND=disabled
EMAIL_FROM=no-reply@workwise.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_MINUTES=30
# Local resume storage (PDF only)
RESUME_DIR=data/resumes
RESUME_MAX_BYTES=2000000

# Transaction pooler (Supabase port 6543): DB_POOLER=true. RESUME_ENABLED=false where the disk is read-only.
DB_POOLER=false
RESUME_ENABLED=true
